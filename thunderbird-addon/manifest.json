{
  "manifest_version": 2,
  "name": "MailChat Sidebar",
  "version": "0.2.0",
  "description": "Autonomes Thunderbird-Add-on: Chatartige Mail-Ansicht als Sidebar und Tab.",
  "applications": {
    "gecko": {
      "id": "mailchat-sidebar@example.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesModify",
    "compose",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "MailChat",
    "default_panel": "sidebar/sidebar.html"
  },
  "browser_action": {
    "default_title": "MailChat öffnen",
    "default_popup": "launcher/launcher.html"
  },
  "commands": {
    "open-mailchat-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+M"
      },
      "description": "MailChat als Tab öffnen"
    }
  }
}
